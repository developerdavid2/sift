{
  "name": "sift",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:server": "turbo run dev -F @sift/backend --",
    "dev:setup": "turbo run dev:setup -F @sift/backend --",
    "prepare": "husky"
  },
  "dependencies": {
    "@sift/env": "*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sift/config": "*",
    "@types/node": "^26.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,astro,svelte}": ""
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "esbuild": true
  },
  "version": "1.0.0"
}
